# Copy to .env and fill in. Never commit .env.

# --- GitHub -------------------------------------------------------------
# A fine-grained personal access token with read-only access:
#   Repository access: the repos you want in Baton (or "All repositories")
#   Permissions: Contents = Read-only, Metadata = Read-only
#   (and Issues = Read and write if you use the New task form)
# Without a token only public repos are visible (and GitHub allows 60 requests/hour).
# When running without Docker, Baton falls back to the GitHub CLI login (`gh auth token`).
GITHUB_TOKEN=

# Your GitHub user. Optional when a token is set (Baton asks GitHub who you are).
BATON_OWNER=

# Optional: only these repos (owner/name, comma separated) instead of scanning all of yours.
BATON_REPOS=
# Optional: skip these repos (name or owner/name, comma separated).
BATON_EXCLUDE=

# --- Page ---------------------------------------------------------------
# Page language: en | es
BATON_LANG=en
BATON_TITLE=Baton
# How long GitHub answers are reused, in seconds.
BATON_CACHE_SECONDS=300
# Warn when the repo changed this many days after STATUS.md's date.
BATON_STALE_DAYS=1
BATON_PORT=8787
# Optional but strongly recommended when running local agents:
# Protects the web UI and API with a signed HttpOnly session cookie so a
# restricted local agent on 127.0.0.1 cannot scrape CSRF tokens or start tasks.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BATON_ACCESS_KEY=

# --- Quotas (Docker only: host folders mounted into the container) --------
# Where `baton statusline` writes Claude Code readings (default ~/.baton when not in Docker).
# Windows example: C:/Users/you/.baton
BATON_HOST_DATA_DIR=./data
# Codex's home folder, for its local rate-limit logs. Windows example: C:/Users/you/.codex
BATON_HOST_CODEX_DIR=./no-codex

# --- Automatic quota checks (only when Baton runs on the same computer as the CLIs) ---
# Every N minutes Baton asks the official CLI for your plan's usage. 0 = off.
# 5-10 minutes keeps the Quotas page fresh. A check is skipped when a fresher
# reading already exists (the CLI you just used reported usage through its
# status line or session logs), so short intervals spend little extra quota.
# Still: each check that does run spends a little quota, and if no 5-hour
# window is open it opens one.
BATON_PING_CLAUDE_MINUTES=0
BATON_PING_CODEX_MINUTES=0
# Only check between these local hours (e.g. 8-24). Empty = any time.
BATON_PING_HOURS=
# Model for the Claude check (the cheapest is enough).
BATON_PING_MODEL=haiku
# Optional: path to the CLIs if they are not on PATH.
# (Claude: Baton also finds the copy bundled with the VS Code extension.)
BATON_CLAUDE_BIN=
BATON_CODEX_BIN=
BATON_OPENCODE_BIN=
# Antigravity CLI (agy.exe) for Gemini; found on PATH or in winget's folder.
BATON_AGY_BIN=
# Optional: your OpenCode Go key, only to show the Go quota (5 h, week, month).
# Type it yourself; Baton sends it only to opencode.ai and never shows it.
BATON_OPENCODE_GO_KEY=

# --- Tasks on this computer (only when Baton runs on the computer with the clones) ---
# Folder that contains your git clones; Baton matches them by their origin remote.
BATON_LOCAL_ROOT=
# Optional: owner/repo=C:/path/to/clone;owner/other=...
BATON_LOCAL_PATHS=
# Agents chat: optional scratch folder offered next to your clones (empty = only clones).
# Example: C:\path\to\scratch or /path/to/scratch
# BATON_CHAT_SCRATCH=
# Checklist prefix for owner-only actions in STATUS.md ("Your turn").
# Plain names are wrapped automatically (e.g. Alice -> (Alice)).
# BATON_OWNER_TAG=(Owner)
# Docker image for isolated Agents chat ("All permissions" mode with local models).
# Build once: docker build -f docker/opencode-sandbox.Dockerfile -t baton-opencode-sandbox:latest .
# BATON_SANDBOX_IMAGE=baton-opencode-sandbox:latest
# Local AI through Codex --oss (Ollama or LM Studio). Empty = option disabled.
BATON_LOCAL_MODEL=
BATON_LOCAL_PROVIDER=ollama
BATON_TASK_TIMEOUT_MINUTES=60
# Commit identity used only when the clone has none configured.
BATON_GIT_NAME=Baton
BATON_GIT_EMAIL=baton@localhost
# 0 hides the "In the cloud (GitHub Actions)" option.
BATON_CLOUD_TASKS=1
# 1: local tasks merge their pull request when the tests pass. Claude Code,
# Codex and Gemini work merges without a review; OpenCode/local AI work is
# first reviewed by Claude Code.
# 0: leave a draft pull request for you to review.
BATON_AUTO_MERGE=1
# Check for Baton updates every five minutes and after merging a Baton task.
BATON_SELF_UPDATE=1
# Windows Task Scheduler name restarted after native self-updates (default: Baton).
# BATON_SCHEDULED_TASK=Baton
# Local tasks running at the same time on this computer (one per repository
# in any case); the rest wait in the queue.
BATON_MAX_PARALLEL=3

# Model and reasoning effort Claude Code reviews with (default: opus, medium;
# set them empty to use the CLI's own default).
# BATON_REVIEW_CLAUDE_MODEL=opus
# BATON_REVIEW_CLAUDE_EFFORT=medium

# --- Notifications (machine alerts + finished/failed tasks) -------------
# Telegram Bot (create with @BotFather; send it a message, then get your chat_id):
BATON_TELEGRAM_BOT_TOKEN=
BATON_TELEGRAM_CHAT_ID=
# Optional generic JSON Webhook or ntfy.sh URL (e.g. https://ntfy.sh/your-topic):
BATON_ALERT_WEBHOOK_URL=
# 1 = also notify when a Baton task finishes or fails (0 = machine alerts only).
BATON_NOTIFY_TASKS=1
